# 9Th-Grade AI — Environment Variables
# Copy this file to .env.local and fill in your values.

# Database (PostgreSQL — schema uses provider = "postgresql")
DATABASE_URL="postgresql://user:password@localhost:5432/ninth_grade_ai"

# Auth
AUTH_SECRET="generate-with: openssl rand -base64 32"

# AI — Anthropic (solver + fallback)
ANTHROPIC_API_KEY="sk-ant-..."

# AI — Groq (tutor + assistant, open-source primary)
GROQ_API_KEY="gsk_..."

# AI — Web search grounding (Tavily, optional; graceful fallback when unset)
TAVILY_API_KEY="tvly-..."

# AI — Model overrides (optional)
AI_GROQ_MODEL="openai/gpt-oss-120b"
AI_ANTHROPIC_MODEL="claude-sonnet-4-6"
AI_TARGET_EXAM="BCS"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"