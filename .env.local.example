# 9Th-Grade AI — Environment Variables
# Copy this file to .env.local and fill in your values.
#
# Classification (docs/SECURITY.md § Secrets):
#   PRIVILEGED — server-only credentials. Never prefix these with NEXT_PUBLIC_,
#                never import them into client components, never log them.
#   SENSITIVE  — server-side config that is not a credential but should not be
#                broadcast (internal URLs, tuning knobs).
#   PUBLIC     — NEXT_PUBLIC_* variables are INLINED INTO THE BROWSER BUNDLE
#                at build time. Only put values that are safe to publish there.
#
# .env.local is gitignored. CI scans every commit for leaked secrets
# (`npm run secret-scan` locally, CI job `secret-scan`); see docs/SECURITY.md.

# ── Database (PostgreSQL — Neon serverless) — PRIVILEGED ─────────────────────
# Pooled connection for app queries, direct for migrations.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── Auth — PRIVILEGED ────────────────────────────────────────────────────────
# JWT signing secret. Generate: openssl rand -base64 32
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Optional: the previous secret while rotating — verification accepts it as a
# grace window so existing sessions survive the rotation (backend/auth.ts).
# AUTH_SECRET_PREVIOUS=""

# ── Google OAuth 2.0 / OIDC (optional — "Continue with Google") — PRIVILEGED ─
# Uses Authorization Code flow with PKCE; no client_secret-in-browser. Create
# credentials at https://console.cloud.google.com/apis/credentials (Web
# application, authorized redirect URI = https://<host>/api/auth/google/callback).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Recommended override when the proxied/canonical host differs from the
# browser-facing origin (full callback URL, e.g. https://<host>/api/auth/google/callback).
# GOOGLE_AUTH_REDIRECT_URI=""
# Legacy alias — accepted only when it points at the sign-in callback
# (backend/auth/google.ts). Prefer GOOGLE_AUTH_REDIRECT_URI above.
# GOOGLE_REDIRECT_URI=""
# Rate limit for Google sign-in initiation (per IP, per minute).
RL_GOOGLE_PER_MIN="10"

# ── Google Drive storage — OAuth token encryption key — PRIVILEGED ───────────
# Must differ from AUTH_SECRET (backend/services/storage/encryption.ts).
GOOGLE_OAUTH_ENCRYPTION_KEY="generate-with: openssl rand -base64 32"

# ── AI — Anthropic (solver + fallback) — PRIVILEGED ──────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── AI — Groq (tutor + assistant, open-source primary) — PRIVILEGED ──────────
GROQ_API_KEY="gsk_..."

# AI — Groq, dedicated key for MCQ explanations (AI Exp. buttons on
# Practice / Mock / Custom-exam review, all subjects + ecosystems).
# Explanation traffic uses this key so it never touches the Assistant's
# quota. When unset, explanations fall back to GROQ_API_KEY.
GROQ_API_KEY_EXPLAIN="gsk_..."

# AI — Web search grounding (Tavily, optional; graceful fallback when unset)
TAVILY_API_KEY="tvly-..."

# AI — Verified MCQ explanations (explain-v2). Default ON. Set to 0/false/off
# to roll back to the legacy explanation without a deploy; the UI then shows
# the explicit "unverified" banner.
AI_EXPLAIN_V2_ENABLED="1"

# ── Transactional email (verification links) — PRIVILEGED — docs/EMAIL.md ────
# SMTP is the recommended $0 option (e.g. Gmail App Password, no custom domain).
# When SMTP is unset, RESEND_API_KEY is used; when neither is set, accounts
# auto-verify (no email is delivered).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
RESEND_API_KEY=""

# ── AI — Model overrides (optional) — SENSITIVE (server-side) ────────────────
AI_GROQ_MODEL="openai/gpt-oss-120b"
AI_ANTHROPIC_MODEL="claude-sonnet-4-6"
AI_TARGET_EXAM="BCS"
# Provider-swap point (Phase 4): Groq serves an OpenAI-compatible API — set this
# to another OpenAI-compatible gateway to swap the inference backend unchanged.
# AI_GROQ_BASE_URL=""

# AI — Model Router (Phase 16). Defaults keep behavior identical to the legacy
# path: Groq primary for tutor/assistant, Anthropic for solver + vision, with
# mock fallback when no key is set (responses are labelled source:"mock").
# AI_PROVIDER="anthropic"   # force Anthropic as the primary provider
AI_MODEL_PRIMARY="openai/gpt-oss-120b"
AI_MODEL_FAST="openai/gpt-oss-120b"
AI_TEMPERATURE="0.4"
AI_MAX_OUTPUT_TOKENS="4096"
AI_REASONING_EFFORT="medium"

# ── App — PUBLIC (NEXT_PUBLIC_* is inlined into the client bundle) ───────────
# Canonical site URL — sitemap/robots/metadata/SEO (frontend/lib/seo.ts).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Browser-facing origin (OAuth diagnostics, storage callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# PUBLIC — Sentry DSN for the browser bundle (a DSN only authorizes event
# submission; it is not a credential). Set when enabling client error reports.
NEXT_PUBLIC_SENTRY_DSN=""
# PUBLIC — perf beacon endpoint; unset = metrics stay in-memory only.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=""

# App — SENSITIVE (server-side)
# Canonical server-side app URL (fallbacks, OAuth callbacks). Keep in sync
# with NEXT_PUBLIC_APP_URL.
APP_URL="http://localhost:3000"
# Comma-separated origins allowed to receive CORS headers (same-origin always
# allowed). Example: ALLOWED_ORIGINS="https://9th-grade-ai.vercel.app"
ALLOWED_ORIGINS="http://localhost:3000"

# ── Cron / background workers — PRIVILEGED ───────────────────────────────────
# Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically.
# Required in production or cron routes return 503/401.
CRON_SECRET="generate-with: openssl rand -hex 32"
# Optional separate secret for the storage worker (falls back to CRON_SECRET).
# WORKER_SECRET=""

# ── Sentry (optional — server-side error reporting) — SENSITIVE ──────────────
# When unset, instrumentation is a no-op.
SENTRY_DSN=""

# ── AI — daily spend guard (USD). Enforced in backend/rate-limit.ts ──────────
AI_DAILY_BUDGET_USD="5"

# AI — Current Affairs generation model (Groq). Default: llama-3.3-70b-versatile.
AI_CURRENT_AFFAIRS_MODEL="llama-3.3-70b-versatile"

# ── Rate Limiting (Phase 8 — all optional; defaults shown) — SENSITIVE ───────
RL_LOGIN_PER_MIN="5"
RL_REGISTER_PER_MIN="3"
RL_REFRESH_PER_MIN="20"
RL_PASSWORD_PER_MIN="5"
RL_LOGIN_ACCOUNT_PER_HOUR="10"
RL_AI_PER_MIN="10"
RL_AI_DAILY="60"
RL_SUBMIT_PER_MIN="30"
RL_PUBLIC_PER_MIN="120"

# Set to "false" to stop trusting platform IP headers (x-forwarded-for etc.);
# anonymous rate-limit keys collapse into one opaque bucket. Keep "true" only
# behind a sanitizing proxy (Vercel, Cloudflare) that overwrites these headers.
TRUST_CLIENT_IP="true"

# ── Distributed rate limiting — PRIVILEGED (contains credentials in URL) ─────
# REQUIRED in production — docs/DECISIONS.md ADR-0009. Without it each
# serverless instance enforces its own counters. If Redis is briefly
# unreachable requests fail OPEN and the outage is logged.
REDIS_URL=""

# ── Storage (Phase 17) — local-disk default; S3-compatible driver pending ────
STORAGE_DRIVER="local-disk"
STORAGE_LOCAL_DIR=".data/storage"

# ── Observability (Phase 18) — structured JSON logs in production automatically ─
# Pino log level (debug/info/warn/error). Defaults: debug locally, info in prod.
LOG_LEVEL=""

# ── RAG / embeddings (Phase 15) — pipeline flag-off until pgvector + key ─────
EMBEDDINGS_ENABLED="false"
