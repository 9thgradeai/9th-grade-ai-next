# 9Th-Grade AI — Environment Variables
# Copy this file to .env.local and fill in your values.

# Database (PostgreSQL — schema uses provider = "postgresql")
# Serverless/Neon: use the POOLED connection string and cap the per-instance
# pool so Vercel fan-out cannot exhaust max_connections, e.g.:
#   postgresql://user:pass@ep-x-pooler.region.aws.neon.tech/db?connection_limit=10
DATABASE_URL="postgresql://user:password@localhost:5432/ninth_grade_ai"

# Auth
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth 2.0 / OIDC (optional — "Continue with Google"). Uses Authorization
# Code flow with PKCE; no client_secret-in-browser. Create credentials at
# https://console.cloud.google.com/apis/credentials (Web application, authorized
# redirect URI = https://<host>/api/auth/google/callback).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: override the redirect URI when proxied/canonical host differs from the
# browser-facing origin (defaults to <origin>/api/auth/google/callback).
# GOOGLE_REDIRECT_URI=""
# Rate limit for Google sign-in initiation (per IP, per minute).
RL_GOOGLE_PER_MIN="10"

# AI — Anthropic (solver + fallback)
ANTHROPIC_API_KEY="sk-ant-..."

# AI — Groq (tutor + assistant, open-source primary)
GROQ_API_KEY="gsk_..."

# AI — Web search grounding (Tavily, optional; graceful fallback when unset)
TAVILY_API_KEY="tvly-..."

# AI — Model overrides (optional)
AI_GROQ_MODEL="openai/gpt-oss-120b"
AI_ANTHROPIC_MODEL="claude-sonnet-4-6"
AI_TARGET_EXAM="BCS"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Rate Limiting (Phase 8 — all optional; defaults shown)
RL_LOGIN_PER_MIN="5"
RL_REGISTER_PER_MIN="3"
RL_REFRESH_PER_MIN="20"
RL_PASSWORD_PER_MIN="5"
RL_LOGIN_ACCOUNT_PER_HOUR="10"
RL_AI_PER_MIN="10"
RL_AI_DAILY="60"

# Set to "false" to stop trusting platform IP headers (x-forwarded-for etc.);
# anonymous rate-limit keys collapse into one opaque bucket.
TRUST_CLIENT_IP="true"

# Distributed rate limiting (REQUIRED in production — docs/DECISIONS.md ADR-0009).
# Without it each serverless instance enforces its own counters. If Redis is
# briefly unreachable requests fail OPEN and the outage is logged.
REDIS_URL=""
# Storage (Phase 17) — local-disk default; S3-compatible driver pending adoption
STORAGE_DRIVER="local-disk"
STORAGE_LOCAL_DIR=".data/storage"

# Observability (Phase 18) — structured JSON logs in production automatically;
# force with json | pretty
LOG_FORMAT=""

# RAG / embeddings (Phase 15) — pipeline flag-off until pgvector host + provider key
EMBEDDINGS_ENABLED="false"
