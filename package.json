{
  "name": "9th-grade-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "prisma db push --schema database/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema database/prisma/schema.prisma",
    "db:seed-users": "SEED_RESET_USERS=1 prisma db seed --schema database/prisma/schema.prisma",
    "db:seed-questions": "tsx scripts/seed-questions.ts",
    "db:reset": "prisma db push --force-reset --schema database/prisma/schema.prisma && SEED_RESET_USERS=1 prisma db seed --schema database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema database/prisma/schema.prisma",
    "db:migrate-deploy": "prisma migrate deploy --schema database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema database/prisma/schema.prisma",
    "postinstall": "prisma generate --schema database/prisma/schema.prisma",
    "prepare": "prisma generate --schema database/prisma/schema.prisma",
    "analyze": "ANALYZE=true npm run build",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "prisma": {
    "seed": "tsx database/prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/groq": "^1.2.9",
    "@prisma/client": "^6.5.0",
    "ai": "^4.3.16",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/test": "^8.6.15",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.0",
    "prisma": "^6.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
