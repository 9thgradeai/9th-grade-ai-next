{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "9th-grade-ai-docs": {
        "type": "remote",
        "url": "https://gitmcp.io/9thgradeai/9th-grade-ai-next"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ]
      },
      "postgres": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@microsoft/postgres-mcp",
          "run"
        ]
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      }
    }
  }
}