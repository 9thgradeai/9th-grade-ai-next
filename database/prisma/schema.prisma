// Prisma schema for 9Th-Grade AI
// PostgreSQL for all environments (local + Vercel/Railway). Local dev uses
// a local Postgres instance; production uses Railway Postgres via DATABASE_URL.

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────
enum UserRole {
  STUDENT
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum QuizStatus {
  ACTIVE
  AVAILABLE
  NEW
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  REMINDER
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

// ── AI ────────────────────────────────────────────────────
enum AIConversationKind {
  TUTOR
  ASSISTANT
  SOLVER
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIMessageStatus {
  COMPLETE
  STREAMING
  FAILED
}

enum AIMemoryType {
  WEAK_TOPIC
  STRONG_TOPIC
  RECURRING_MISTAKE
  PREFERRED_LANGUAGE
  LEARNING_PREFERENCE
  EXAM_GOAL
  DIFFICULTY_PREFERENCE
  CORRECTION
}

enum AIMemorySource {
  INFERRED
  USER
  SYSTEM
}

enum AIUsageTask {
  TUTOR
  SOLVER
  ASSISTANT
}

enum AIFeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum DailyQuizParticipationStatus {
  IN_PROGRESS
  COMPLETED
}

// ── Auth ──────────────────────────────────────────────────
model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  emailVerified Boolean       @default(false)
  handle       String         @unique
  passwordHash String         @default("")
  // Bumped on password change / global revoke — JWTs carry the version they
  // were minted with; any token whose version is stale is rejected on verify.
  tokenVersion Int            @default(0)

  // ── Social auth (Google OAuth 2.0 / OIDC) ──
  // googleId is the stable Google subject (`sub`). Null for password-only
  // accounts. `authProvider` records how the account was established so the UI
  // and login route can (a) show the right badge and (b) block password login
  // for Google-only accounts. `imageUrl` carries the Google avatar.
  googleId      String?        @unique
  appleId       String?        @unique
  authProvider  String         @default("password") // "password" | "google" | "apple" | "both"
  imageUrl      String?
  role         UserRole       @default(STUDENT)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // ── Onboarding (captured post-signup; powers the study planner) ──
  examTarget         String?
  examDate           DateTime?
  prepLevel          String? // BEGINNER | INTERMEDIATE | ADVANCED
  studyHoursPerDay   Int?
  goal               String?
  onboarded          Boolean  @default(false)

  // ── Email verification (raw token is emailed; only the SHA-256 hash is stored) ──
  emailVerifyToken   String?
  emailVerifyExpires DateTime?

  // ── Password reset (raw token is emailed; only the SHA-256 hash is stored) ──
  passwordResetToken   String?
  passwordResetExpires DateTime?

  progress     UserProgress?
  bookmarks    Bookmark[]
  studyTasks   StudyTask[]
  notifications AppNotification[]
  attempts     QuestionAttempt[]
  mockTestResults MockTestResult[]
  flashcardReviews FlashcardReview[]
  notificationReads NotificationRead[]
  aiConversations AIConversation[]
  aiMemories    AIMemory[]
  aiUsage       AIUsage[]
  aiFeedback    AIFeedback[]
  dailyQuizParticipations DailyQuizParticipation[]
  flashcardUserStates     FlashcardUserState[]
  studyTaskCompletions    StudyTaskCompletion[]
  userBadges              UserBadge[]

  // NOTE: `email` and `handle` are @unique — their backing indexes already
  // serve lookups; explicit duplicates were removed (write amplification).
}

// ── Content taxonomy ──────────────────────────────────────
model Subject {
  id           Int      @id @default(autoincrement())
  nameBn       String   @unique
  nameEn       String
  icon         String   @default("📘")
  color        String?  @default("text-emerald-400")
  bg           String?  @default("bg-emerald-500/10")
  sortOrder    Int      @default(0)
  topics       Topic[]
  questions    Question[]
  flashcards   Flashcard[]
  categories   QuestionBankCategory[]
  attempts     QuestionAttempt[]
  aiConversations AIConversation[]

  @@index([sortOrder])
}

model Topic {
  id           Int     @id @default(autoincrement())
  subjectId    Int
  subject      Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parentId     Int?
  parent       Topic?  @relation("TopicTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Topic[] @relation("TopicTree")
  name         String // display name (taxonomy node name), e.g. "০২_নিরাপ্তা_ও_ক্ষমতা"
  slug         String // path segment (defaults to name)
  path         String // full content path from subject root, e.g. "04_আন্তর্জাতিক_বিষয়াবলি/০২_নিরাপ্তা_ও_ক্ষমতা/আন্তর্জাতিক_নিরাপ্তা"
  depth        Int    @default(0)
  sortOrder    Int    @default(0)
  questionCount String @default("0")
  questions    Question[]
  aiConversations AIConversation[]

  @@unique([subjectId, path])
  @@index([subjectId, parentId])
}

// ── Questions ─────────────────────────────────────────────
model Question {
  id             Int      @id @default(autoincrement())
  subjectId      Int
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId        Int?
  leaf           Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  path           String   @default("") // full leaf content path, e.g. "04_আন্তর্জাতিক_বিষয়াবলি/০২_নিরাপ্তা_ও_ক্ষমতা/আন্তর্জাতিক_নিরাপ্তা"
  topic          String   @default("") // topic group display name (depth-1 node)
  subtopic       String   @default("") // leaf display name (Topic.name)
  question       String
  options        Json // string[]
  correctAnswer  String
  explanation    String   @default("")
  difficulty     Difficulty @default(MEDIUM)
  year           Int?
  sourceExam     String   @default("")
  bcsTerm        String?  // e.g., "50th", "49th", "48th" — BCS exam term
  // Deterministic seed identity (md5 of subjectId|path|question). Lets the
  // seeder upsert instead of wipe-and-recreate, so Question ids — and every
  // user row referencing them — stay stable across deploys.
  sourceKey      String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bookmarks      Bookmark[]
  attempts       QuestionAttempt[]

  @@index([subjectId, difficulty])
  @@index([subjectId, path])
  // FK-side index: Topic SetNull updates/deletes must not seq-scan Questions.
  @@index([topicId])
  @@index([subjectId, topic, subtopic])
  @@unique([subjectId, sourceKey])
}

model QuestionBankCategory {
  id        Int      @id @default(autoincrement())
  subjectId Int?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  label     String   @unique
  count     Int      @default(0)
}

model ExamArchive {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  icon      String  @default("🎯")
  count     Int     @default(0)
  yearRange String  @default("")
  status    QuizStatus @default(ACTIVE)
  accent    String?
}

// ── Flashcards (SRS) ──────────────────────────────────────
// DEPRECATED (Phase 2B2): `nextReview` / `interval` / `easeFactor` /
// `repetitions` on this row are legacy shared defaults. Authoritative SRS
// scheduling lives per-user in FlashcardUserState.
model Flashcard {
  id           Int      @id @default(autoincrement())
  subjectId    Int?
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName  String   @default("")
  question     String
  answer       String
  hint         String   @default("")
  difficulty   Difficulty @default(MEDIUM)
  nextReview   DateTime @default(now())
  interval     Int      @default(1)
  easeFactor   Float    @default(2.5)
  repetitions  Int      @default(0)
  // Seed identity: md5(subjectName|question) — keeps card ids stable.
  sourceKey    String   @default("") @unique
  reviews      FlashcardReview[]
  userStates   FlashcardUserState[]

  @@index([subjectId])
  @@index([nextReview])
}

// Per-user SM-2 scheduling state. One row appears after the first review;
// unseen cards have no row (implicitly new).
model FlashcardUserState {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId Int
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  nextReview  DateTime  @default(now())
  interval    Int       @default(1) // days until next review
  easeFactor  Float     @default(2.5)
  repetitions Int       @default(0)
  lapses      Int       @default(0) // times rated "again"
  lastRating  Int? // 0=again 1=hard 2=good 3=easy
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, flashcardId])
  @@index([userId, nextReview])
}

// ── Study planner ─────────────────────────────────────────
model StudyPlanDay {
  id           Int          @id @default(autoincrement())
  day          String
  date         String
  totalMinutes Int          @default(0)
  focusAreas   Json // string[]
  // Seed identity: md5(day|date).
  sourceKey    String       @default("") @unique
  tasks        StudyTask[]

  @@index([date])
}

model StudyTask {
  id          Int           @id @default(autoincrement())
  dayId       Int
  planDay     StudyPlanDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  // Nullable = shared template row seeded for everyone. User-created custom
  // tasks (userId set) remain possible; per-user completion of template rows
  // lives in StudyTaskCompletion.
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  subject     String        @default("")
  duration    Int           @default(0)
  priority    Priority      @default(MEDIUM)
  description String        @default("")
  // DEPRECATED (Phase 2B2): legacy column, superseded by StudyTaskCompletion.
  completed   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  completions StudyTaskCompletion[]

  // FK-side index: user account deletion cascades here; composite below
  // leads with dayId so userId lookups need their own index.
  @@index([userId])
  @@index([dayId, userId])
}

// Per-user completion marker for a (usually template) study task. Replaces
// the shared `completed` boolean so one user's progress never affects another.
model StudyTaskCompletion {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      Int
  task        StudyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, taskId])
  @@index([userId])
}

// ── Daily quizzes ─────────────────────────────────────────
// DEPRECATED (Phase 2): `completed` / `score` / `claimed` on this row are
// legacy GLOBAL state shared by every user. They are kept only for the
// dual-read transition; the authoritative per-user state now lives in
// DailyQuizParticipation. Do not read these columns from new code.
model DailyQuiz {
  id        Int           @id @default(autoincrement())
  date      String        @unique
  completed Boolean       @default(false)
  score     Int           @default(0)
  claimed   Boolean       @default(false)
  createdAt DateTime      @default(now())
  questions QuizQuestion[]
  participations DailyQuizParticipation[]

  // `date` is @unique — its unique index serves lookups; duplicate removed.
}

// Per-user daily-quiz participation — one row per (user, quiz).
// Replaces the accidental global completion flags on DailyQuiz.
model DailyQuizParticipation {
  id          Int                         @id @default(autoincrement())
  userId      String
  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      Int
  dailyQuiz   DailyQuiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  status      DailyQuizParticipationStatus @default(IN_PROGRESS)
  score       Int                         @default(0) // percentage 0–100
  correct     Int                         @default(0)
  total       Int                         @default(0)
  pointsEarned Int                        @default(0)
  completedAt DateTime?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@unique([userId, quizId])
  @@index([quizId])
  @@index([userId, completedAt])
}

model QuizQuestion {
  id             Int        @id @default(autoincrement())
  dailyQuizId    Int
  dailyQuiz      DailyQuiz  @relation(fields: [dailyQuizId], references: [id], onDelete: Cascade)
  subject        String     @default("")
  topic          String     @default("")
  question       String
  options        Json
  correctAnswer  String
  explanation    String     @default("")

  // FK-side index: seed's atomic replace deletes by dailyQuizId.
  @@index([dailyQuizId])
}

// ── Mock tests ────────────────────────────────────────────
model MockTest {
  id              Int               @id @default(autoincrement())
  title           String            @unique
  subject         String            @default("")
  totalQuestions  Int               @default(0)
  duration        Int               @default(0)
  questions       MockTestQuestion[]
  results         MockTestResult[]
}

model MockTestQuestion {
  id             Int       @id @default(autoincrement())
  mockTestId     Int
  mockTest       MockTest  @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  subject        String    @default("")
  topic          String    @default("")
  question       String
  options        Json
  correctAnswer  String
  explanation    String    @default("")
}

// ── Exam schedule (real published exam dates) ─────────────
model ExamSchedule {
  id          Int      @id @default(autoincrement())
  titleBn     String
  titleEn     String   @default("")
  type        String   @default("BCS") // BCS | BANK | TEACHER | OTHER
  date        DateTime
  year        String   @default("")
  circularNo  String   @default("")
  note        String   @default("")
  sortOrder   Int      @default(0)
  sourceUrl   String?  @default("") // Link to the verified official circular
  verified    Boolean  @default(false) // Only verified entries are surfaced by the API
  // Seed identity: md5(circularNo|titleBn|year).
  sourceKey   String   @default("") @unique

  @@index([date])
  @@index([type])
}

// ── News / recommendations / gamification ────────────────
model FlashNews {
  id          Int     @id @default(autoincrement())
  tag         String  @default("EXAM")
  titleBn     String
  titleEn     String? @default("")
  text        String  @default("")
  full        String  @default("")
  date        String  @default("")
  readTime    Int     @default(1)
  categoryBn  String? @default("")
  categoryEn  String? @default("")
  sourceUrl   String? @default("") // Link to the verified official source
  verified    Boolean  @default(false) // Only verified items are surfaced by the API
  // Seed identity: md5(titleBn|date).
  sourceKey   String  @default("") @unique
}

model Recommendation {
  id             Int     @id @default(autoincrement())
  subjectBn      String
  subjectEn      String? @default("")
  metric         String  @default("accuracy")
  accuracy       Int     @default(0)
  titleBn        String
  titleEn        String? @default("")
  descriptionBn  String
  descriptionEn  String? @default("")
  ctaBn          String
  ctaEn          String? @default("")
  // Seed identity: md5(subjectBn|titleBn).
  sourceKey      String  @default("") @unique
}

model Badge {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  description  String
  icon         String     @default("🏅")
  rarity       BadgeRarity @default(COMMON)
  // DEPRECATED (Phase 2B2): seed-time catalog flag; real unlocks live in UserBadge.
  unlockedSeed Boolean    @default(false)
  userBadges   UserBadge[]
}

// Per-user badge unlock. Catalog state (Badge) stays shared; this is earned state.
model UserBadge {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    Int
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model AppNotification {
  id        Int            @id @default(autoincrement())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String
  message   String
  type      NotificationType @default(INFO)
  timestamp DateTime       @default(now())
  read      Boolean        @default(false)
  reads     NotificationRead[]
  // Seed identity: md5(title|message) — NotificationRead rows reference this
  // row, so ids must survive reseeds.
  sourceKey String         @default("") @unique

  @@index([userId])
  // Keyset pagination orders by (timestamp desc, id desc).
  @@index([timestamp, id])
}

model OfflinePack {
  id         Int    @id @default(autoincrement())
  name       String @unique
  size       String @default("")
  downloaded Boolean @default(false)
  subject    String @default("")
}

// ── Documents (syllabus, circulars, guides) ──────────────
model Document {
  id          Int     @id @default(autoincrement())
  title       String
  category    String  @default("Syllabus") // Syllabus | Circular | Guide
  type        String  @default("md") // md | pdf
  url         String  @default("")
  description String  @default("")
  year        String  @default("")
  createdAt   DateTime @default(now())
  // Seed identity: md5(title|category|year).
  sourceKey   String  @default("") @unique
}

// ── Sessions ──────────────────────────────────────────────
// REMOVED (Phase 10): `UserSession` was dead infrastructure — the app uses
// stateless JWTs with an absolute lifetime cap (see /api/auth/refresh).
// Dropped by migration 000000000005_drop_user_session.

// ── Per-user state ────────────────────────────────────────
model UserProgress {
  id                 Int    @id @default(autoincrement())
  userId             String @unique
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  points             Int    @default(0)
  streak             Int    @default(0)
  accuracy           Int    @default(0)
  questionsAnswered  Int    @default(0)
  flashcardsReviewed Int    @default(0)
  aiQuestionsAsked   Int    @default(0)
  examsAttempted     Int    @default(0)
  rank               Int    @default(0)
  updatedAt          DateTime @updatedAt

  // Serves the leaderboard-rank computation: count of progress rows with
  // more points than the caller's (index range scan instead of seq scan).
  @@index([points])
}

model Bookmark {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  // FK-side index for Question cascade deletes (unique above leads with userId).
  @@index([questionId])
}

// ── Per-user activity ────────────────────────────────────
// Every answered question (practice, mock test, daily quiz). Powers
// accuracy, streaks, and per-subject reports.
model QuestionAttempt {
  id         Int       @id @default(autoincrement())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId Int?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  subjectId  Int?
  subject    Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName String   @default("")
  topic      String    @default("")
  correct    Boolean
  source     String    @default("practice") // practice | mock | daily
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, subjectId])
  // FK-side index: Question SetNull on delete/update must not seq-scan attempts.
  @@index([questionId])
  // Analytics group-bys filter by userId and aggregate per subject/topic.
  @@index([userId, subjectName])
  @@index([userId, topic])
}

// Mock-test attempts (graded results) for history + exam KPIs.
model MockTestResult {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTestId  Int?
  mockTest    MockTest? @relation(fields: [mockTestId], references: [id], onDelete: SetNull)
  score       Int      @default(0) // percentage 0-100
  correct     Int      @default(0)
  total       Int      @default(0)
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  // FK-side index for MockTest SetNull.
  @@index([mockTestId])
}

// Per-user flashcard SRS reviews (log). nextReview scheduling is derived
// from these; the base Flashcard row stays shared content.
model FlashcardReview {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId Int
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  rating      Int       @default(0) // 0=again 1=hard 2=good 3=easy
  createdAt   DateTime  @default(now())

  @@index([userId, flashcardId])
  // FK-side index: Flashcard cascade deletes scan this column.
  @@index([flashcardId])
}

// Per-user "read" marker for the global announcement feed.
model NotificationRead {
  id             Int            @id @default(autoincrement())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId Int
  notification   AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  readAt         DateTime       @default(now())

  @@unique([userId, notificationId])
}

// ── AI: conversations, memory, usage, feedback ─────────────
// AI is a first-class domain. Conversations reference the existing User,
// Subject and Topic models — no isolated "AI database".
model AIConversation {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       AIConversationKind @default(TUTOR)
  title      String             @default("New conversation")
  pinned     Boolean            @default(false)
  subjectId  Int?
  subject    Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId    Int?
  topic      Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicPath  String             @default("") // path of the Topic when the conversation is topic-scoped
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  messages   AIMessage[]

  @@index([userId, updatedAt])
  @@index([userId, kind, updatedAt])
}

model AIMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   AIConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole
  status         AIMessageStatus @default(COMPLETE)
  content        String
  intent         String?         @default("") // task intent, e.g. "tutor", "explain", "hint", "solve"
  provider       String?         @default("") // provider that generated this message
  model          String?         @default("") // model that generated this message
  metadata       Json?           // non-sensitive context (subject/topic/question id); never system prompts
  errorCode      String?         @default("")
  createdAt      DateTime        @default(now())
  feedback       AIFeedback[]

  @@index([conversationId, createdAt])
}

// Persistent learning memory about the learner. Written deliberately by the
// AI application layer — the model never writes arbitrary memory directly.
model AIMemory {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AIMemoryType
  key        String
  value      String
  source     AIMemorySource @default(INFERRED)
  confidence Int            @default(50) // 0-100
  expiresAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, type, key])
  @@index([userId, type])
}

// Usage/cost/observability ledger for every AI call. No prompt content stored.
model AIUsage {
  id              String       @id @default(cuid())
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  task            AIUsageTask
  intent          String?      @default("")
  provider        String
  model           String
  inputTokens     Int          @default(0)
  outputTokens    Int          @default(0)
  totalTokens     Int          @default(0)
  latencyMs       Int          @default(0)
  success         Boolean      @default(true)
  errorCode       String?      @default("")
  estimatedCostUsd Float       @default(0)
  createdAt       DateTime     @default(now())

  @@index([userId, createdAt])
  // Daily quota backstop filters userId + createdAt + task.
  @@index([userId, task, createdAt])
  @@index([task, createdAt])
  @@index([model, createdAt])
}

// Lightweight user feedback on AI responses — the seed of an evaluation set.
model AIFeedback {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String?
  message   AIMessage?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  rating    AIFeedbackRating
  category  String?           @default("") // e.g. "hallucination", "wrong_language", "unhelpful"
  comment   String?           @default("")
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([messageId])
}
